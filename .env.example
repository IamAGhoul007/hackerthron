# ===== App =====
APP_ENV=development            # development | production
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=http://localhost:8000
ADMIN_API_KEY=change-me-admin-key
RATE_LIMIT_PER_MIN=30

# ===== LLM =====
LLM_PROVIDER=gemini            # gemini | openai
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.1

# ===== Embeddings =====
EMBEDDING_PROVIDER=local       # local | openai | gemini
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ===== Data paths =====
JIRA_DUMP_PATH=./data/jira/jira_tickets_dump.txt
CODE_DIR=./sample_app
CHROMA_DIR=./data/chroma
CACHE_DIR=./data/cache
LOG_DIR=./data/logs

# ===== Retrieval tuning =====
TOP_K_RETRIEVE=12
TOP_K_CONTEXT=5
JIRA_CONFIDENCE_THRESHOLD=0.55
CODE_CONFIDENCE_THRESHOLD=0.50
RRF_K=60
ENABLE_RERANK=true
ENABLE_CROSS_CHECK=true

# ===== Ingestion =====
MAX_CODE_FILE_KB=256
CODE_IGNORE_GLOBS=**/*.min.js,**/*.map
INGEST_CONCURRENCY=4
GENERATE_FILE_DIGESTS=true

# ===== Sessions =====
SESSION_TTL_MINUTES=60
MAX_HISTORY_TURNS=6
